{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpyw/sql-http-proxy/internal/config/schema.json",
  "title": "sql-http-proxy configuration",
  "description": "Configuration file schema for sql-http-proxy",
  "type": "object",
  "properties": {
    "global_helpers": {
      "title": "Global Helpers",
      "oneOf": [
        {
          "title": "Inline JavaScript (string)",
          "type": "string",
          "minLength": 1,
          "description": "Inline JavaScript helpers (shorthand for global_helpers.js)"
        },
        {
          "title": "JavaScript Files (object)",
          "type": "object",
          "properties": {
            "js": {
              "title": "Inline JavaScript",
              "type": "string",
              "minLength": 1,
              "description": "Inline JavaScript helper code"
            },
            "js_files": {
              "title": "JavaScript File Paths",
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "description": "Paths to JavaScript helper files (relative to config)"
            }
          },
          "anyOf": [
            { "required": ["js"] },
            { "required": ["js_files"] }
          ],
          "additionalProperties": false
        }
      ],
      "description": "Global JavaScript helpers available in all JS contexts (pre, post, mock JS, filter, csv.value_parser)"
    },
    "csv": {
      "title": "CSV Config",
      "type": "object",
      "properties": {
        "value_parser": {
          "title": "Value Parser",
          "type": "string",
          "minLength": 1,
          "description": "JavaScript code to parse CSV cell values. Receives: value. Returns: parsed value"
        }
      },
      "additionalProperties": false,
      "description": "Global CSV parsing options"
    },
    "dsn": {
      "title": "DSN",
      "type": ["string", "null"],
      "description": "Database connection string. Supports ${VAR}, $VAR, ${VAR:-default} environment variable expansion. Required unless all operations use mock"
    },
    "queries": {
      "title": "Queries",
      "type": "array",
      "items": {
        "title": "Query",
        "oneOf": [
          { "$ref": "#/$defs/queryOne" },
          { "$ref": "#/$defs/queryMany" }
        ]
      },
      "minItems": 1,
      "description": "List of query endpoints (SELECT)"
    },
    "mutations": {
      "title": "Mutations",
      "type": "array",
      "items": {
        "title": "Mutation",
        "oneOf": [
          { "$ref": "#/$defs/mutationOne" },
          { "$ref": "#/$defs/mutationMany" },
          { "$ref": "#/$defs/mutationNone" }
        ]
      },
      "minItems": 1,
      "description": "List of mutation endpoints (INSERT/UPDATE/DELETE)"
    }
  },
  "anyOf": [
    { "required": ["queries"] },
    { "required": ["mutations"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "path": {
      "title": "Endpoint Path",
      "type": "string",
      "pattern": "^/",
      "description": "HTTP endpoint path (must start with /)"
    },
    "sql": {
      "title": "SQL Query",
      "type": "string",
      "minLength": 1,
      "description": "SQL query with named placeholders (:name)"
    },
    "method": {
      "title": "HTTP Method (Mutation)",
      "type": "string",
      "enum": ["POST", "PUT", "PATCH", "DELETE"],
      "description": "HTTP method for mutation (default: POST)"
    },
    "queryMethod": {
      "title": "HTTP Method (Query)",
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "description": "HTTP method for query (default: GET)"
    },
    "accepts": {
      "title": "Accepted Content-Types",
      "oneOf": [
        {
          "type": "string",
          "enum": ["json", "form"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["json", "form"]
          },
          "minItems": 1
        }
      ],
      "description": "Accepted Content-Types for request body (default: [json, form])"
    },
    "preTransform": {
      "title": "Pre-Transform",
      "type": "string",
      "minLength": 1,
      "description": "JavaScript to transform input before SQL/mock. Receives: input (param), ctx, sql (free vars). Returns: transformed input object"
    },
    "postTransformOne": {
      "title": "Post-Transform (type: one)",
      "type": "string",
      "minLength": 1,
      "description": "JavaScript to transform result. Receives: input, output (params), ctx (free var). Returns: transformed output"
    },
    "postTransformMany": {
      "title": "Post-Transform (type: many)",
      "oneOf": [
        {
          "title": "Post-Transform (all)",
          "type": "string",
          "minLength": 1,
          "description": "JavaScript to transform all rows. Receives: input, output (params), ctx (free var). Returns: transformed output"
        },
        {
          "title": "Post-Transform (each/all)",
          "type": "object",
          "properties": {
            "each": {
              "title": "Post-Transform (each)",
              "type": "string",
              "minLength": 1,
              "description": "JavaScript to transform each row. Receives: input, output (params), ctx (free var). Returns: transformed row"
            },
            "all": {
              "title": "Post-Transform (all)",
              "type": "string",
              "minLength": 1,
              "description": "JavaScript to transform all rows after each. Receives: input, output (params), ctx (free var). Returns: transformed output"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "JavaScript to transform results"
    },
    "filter": {
      "title": "Filter",
      "type": "string",
      "minLength": 1,
      "description": "JavaScript to filter array data. Receives: row, input (params), ctx (free var). Returns: boolean (true to include)"
    },
    "mockOneObject": {
      "title": "Mock (type: one, object sources)",
      "type": "object",
      "oneOf": [
        {
          "title": "YAML Object",
          "properties": {
            "object": {
              "type": "object",
              "description": "Inline YAML object"
            }
          },
          "required": ["object"],
          "additionalProperties": false
        },
        {
          "title": "JSON String (object)",
          "properties": {
            "object_json": {
              "type": "string",
              "minLength": 1,
              "description": "JSON string containing object"
            }
          },
          "required": ["object_json"],
          "additionalProperties": false
        },
        {
          "title": "JSON File (object)",
          "properties": {
            "object_json_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to JSON file containing object"
            }
          },
          "required": ["object_json_file"],
          "additionalProperties": false
        },
        {
          "title": "JavaScript (object)",
          "properties": {
            "object_js": {
              "type": "string",
              "minLength": 1,
              "description": "JavaScript code returning object. Receives: input (param), ctx, sql (free vars)"
            }
          },
          "required": ["object_js"],
          "additionalProperties": false
        }
      ],
      "description": "Mock data source returning single object for type: one"
    },
    "mockOneArray": {
      "title": "Mock (type: one, array sources with filter)",
      "type": "object",
      "oneOf": [
        {
          "title": "YAML Array with filter",
          "properties": {
            "array": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Inline YAML array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array", "filter"],
          "additionalProperties": false
        },
        {
          "title": "JSON String (array) with filter",
          "properties": {
            "array_json": {
              "type": "string",
              "minLength": 1,
              "description": "JSON string containing array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array_json", "filter"],
          "additionalProperties": false
        },
        {
          "title": "JSON File (array) with filter",
          "properties": {
            "array_json_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to JSON file containing array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array_json_file", "filter"],
          "additionalProperties": false
        },
        {
          "title": "CSV with filter",
          "properties": {
            "csv": {
              "type": "string",
              "minLength": 1,
              "description": "Inline CSV data with header row"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["csv", "filter"],
          "additionalProperties": false
        },
        {
          "title": "CSV File with filter",
          "properties": {
            "csv_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to CSV file"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["csv_file", "filter"],
          "additionalProperties": false
        },
        {
          "title": "JSONL with filter",
          "properties": {
            "jsonl": {
              "type": "string",
              "minLength": 1,
              "description": "Inline JSONL data (one JSON object per line)"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["jsonl", "filter"],
          "additionalProperties": false
        },
        {
          "title": "JSONL File with filter",
          "properties": {
            "jsonl_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to JSONL file"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["jsonl_file", "filter"],
          "additionalProperties": false
        }
      ],
      "description": "Mock data source using array with required filter for type: one"
    },
    "mockOne": {
      "title": "Mock (type: one)",
      "oneOf": [
        { "$ref": "#/$defs/mockOneObject" },
        { "$ref": "#/$defs/mockOneArray" }
      ],
      "description": "Mock data source for type: one"
    },
    "mockMany": {
      "title": "Mock (type: many)",
      "type": "object",
      "oneOf": [
        {
          "title": "YAML Array",
          "properties": {
            "array": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Inline YAML array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array"],
          "additionalProperties": false
        },
        {
          "title": "JSON String (array)",
          "properties": {
            "array_json": {
              "type": "string",
              "minLength": 1,
              "description": "JSON string containing array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array_json"],
          "additionalProperties": false
        },
        {
          "title": "JSON File (array)",
          "properties": {
            "array_json_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to JSON file containing array of objects"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["array_json_file"],
          "additionalProperties": false
        },
        {
          "title": "JavaScript (array)",
          "properties": {
            "array_js": {
              "type": "string",
              "minLength": 1,
              "description": "JavaScript code returning array. Receives: input (param), ctx, sql (free vars)"
            }
          },
          "required": ["array_js"],
          "additionalProperties": false
        },
        {
          "title": "CSV",
          "properties": {
            "csv": {
              "type": "string",
              "minLength": 1,
              "description": "Inline CSV data with header row"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["csv"],
          "additionalProperties": false
        },
        {
          "title": "CSV File",
          "properties": {
            "csv_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to CSV file"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["csv_file"],
          "additionalProperties": false
        },
        {
          "title": "JSONL",
          "properties": {
            "jsonl": {
              "type": "string",
              "minLength": 1,
              "description": "Inline JSONL data (one JSON object per line)"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["jsonl"],
          "additionalProperties": false
        },
        {
          "title": "JSONL File",
          "properties": {
            "jsonl_file": {
              "type": "string",
              "minLength": 1,
              "description": "Path to JSONL file"
            },
            "filter": { "$ref": "#/$defs/filter" }
          },
          "required": ["jsonl_file"],
          "additionalProperties": false
        }
      ],
      "description": "Mock data source for type: many (filter is optional)"
    },
    "transformOne": {
      "title": "Transform (type: one)",
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" },
        "post": { "$ref": "#/$defs/postTransformOne" }
      },
      "additionalProperties": false
    },
    "transformMany": {
      "title": "Transform (type: many)",
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" },
        "post": { "$ref": "#/$defs/postTransformMany" }
      },
      "additionalProperties": false
    },
    "transformNone": {
      "title": "Transform (type: none)",
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" }
      },
      "additionalProperties": false,
      "description": "Transform for mutations with no return value (pre only, no post)"
    },
    "queryOne": {
      "title": "Query (type: one)",
      "type": "object",
      "properties": {
        "type": {
          "const": "one",
          "description": "Single row query (404 if not found)"
        },
        "method": { "$ref": "#/$defs/queryMethod" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "mock": { "$ref": "#/$defs/mockOne" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "handle_not_found": {
          "type": "boolean",
          "description": "Pass null to post-transform instead of returning 404"
        },
        "transform": { "$ref": "#/$defs/transformOne" }
      },
      "required": ["type", "path"],
      "oneOf": [
        { "required": ["sql"] },
        { "required": ["mock"] }
      ],
      "additionalProperties": false
    },
    "queryMany": {
      "title": "Query (type: many)",
      "type": "object",
      "properties": {
        "type": {
          "const": "many",
          "description": "Multiple rows query (returns array)"
        },
        "method": { "$ref": "#/$defs/queryMethod" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "mock": { "$ref": "#/$defs/mockMany" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": { "$ref": "#/$defs/transformMany" }
      },
      "required": ["type", "path"],
      "oneOf": [
        { "required": ["sql"] },
        { "required": ["mock"] }
      ],
      "additionalProperties": false
    },
    "mutationOne": {
      "title": "Mutation (type: one)",
      "type": "object",
      "properties": {
        "type": {
          "const": "one",
          "description": "Mutation returning single row (via RETURNING)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "mock": { "$ref": "#/$defs/mockOne" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": { "$ref": "#/$defs/transformOne" }
      },
      "required": ["type", "path"],
      "oneOf": [
        { "required": ["sql"] },
        { "required": ["mock"] }
      ],
      "additionalProperties": false
    },
    "mutationMany": {
      "title": "Mutation (type: many)",
      "type": "object",
      "properties": {
        "type": {
          "const": "many",
          "description": "Mutation returning multiple rows (via RETURNING)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "mock": { "$ref": "#/$defs/mockMany" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": { "$ref": "#/$defs/transformMany" }
      },
      "required": ["type", "path"],
      "oneOf": [
        { "required": ["sql"] },
        { "required": ["mock"] }
      ],
      "additionalProperties": false
    },
    "mutationNone": {
      "title": "Mutation (type: none)",
      "type": "object",
      "properties": {
        "type": {
          "const": "none",
          "description": "Mutation with no return value (204 No Content)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": { "$ref": "#/$defs/transformNone" }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    }
  }
}
