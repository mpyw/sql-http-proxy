{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpyw/sql-http-proxy/internal/config/schema.json",
  "title": "sql-http-proxy configuration",
  "description": "Configuration file schema for sql-http-proxy",
  "type": "object",
  "properties": {
    "dsn": {
      "type": ["string", "null"],
      "description": "Database connection string. Required unless all operations use mock. Can also be set via SQL_PROXY_DSN environment variable"
    },
    "queries": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/queryOne" },
          { "$ref": "#/$defs/queryMany" }
        ]
      },
      "minItems": 1,
      "description": "List of query endpoints (SELECT)"
    },
    "mutations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/mutationOne" },
          { "$ref": "#/$defs/mutationMany" },
          { "$ref": "#/$defs/mutationNone" }
        ]
      },
      "minItems": 1,
      "description": "List of mutation endpoints (INSERT/UPDATE/DELETE)"
    }
  },
  "anyOf": [
    { "required": ["queries"] },
    { "required": ["mutations"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^/",
      "description": "HTTP endpoint path (must start with /)"
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "description": "SQL query with named placeholders (:name)"
    },
    "method": {
      "type": "string",
      "enum": ["POST", "PUT", "PATCH", "DELETE"],
      "description": "HTTP method for mutation (default: POST)"
    },
    "queryMethod": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "description": "HTTP method for query (default: GET)"
    },
    "accepts": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["json", "form"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["json", "form"]
          },
          "minItems": 1
        }
      ],
      "description": "Accepted Content-Types for request body (default: [json, form])"
    },
    "preTransform": {
      "type": "string",
      "description": "JavaScript to transform parameters. Free vars: ctx, sql. Param: input"
    },
    "mockTransform": {
      "oneOf": [
        {
          "type": "string",
          "description": "JavaScript code (shorthand for mock.js)"
        },
        {
          "type": "object",
          "properties": { "js": { "type": "string" } },
          "required": ["js"],
          "additionalProperties": false,
          "description": "JavaScript code. Free vars: ctx, sql. Param: input"
        },
        {
          "type": "object",
          "properties": { "js_file": { "type": "string" } },
          "required": ["js_file"],
          "additionalProperties": false,
          "description": "Path to JavaScript file (relative to config file)"
        },
        {
          "type": "object",
          "properties": { "csv": { "type": "string" } },
          "required": ["csv"],
          "additionalProperties": false,
          "description": "Inline CSV data with header row"
        },
        {
          "type": "object",
          "properties": { "csv_file": { "type": "string" } },
          "required": ["csv_file"],
          "additionalProperties": false,
          "description": "Path to CSV file (relative to config file)"
        },
        {
          "type": "object",
          "properties": { "json": {} },
          "required": ["json"],
          "additionalProperties": false,
          "description": "Inline JSON data (array or object)"
        },
        {
          "type": "object",
          "properties": { "json_file": { "type": "string" } },
          "required": ["json_file"],
          "additionalProperties": false,
          "description": "Path to JSON file (relative to config file)"
        },
        {
          "type": "object",
          "properties": { "jsonl": { "type": "string" } },
          "required": ["jsonl"],
          "additionalProperties": false,
          "description": "Inline JSONL data (one JSON object per line)"
        },
        {
          "type": "object",
          "properties": { "jsonl_file": { "type": "string" } },
          "required": ["jsonl_file"],
          "additionalProperties": false,
          "description": "Path to JSONL file (relative to config file)"
        }
      ],
      "description": "Mock data source (only one type can be specified)"
    },
    "postTransformAll": {
      "type": "string",
      "description": "Transform result. Signature: function(ctx, input, output)"
    },
    "queryOne": {
      "type": "object",
      "properties": {
        "type": {
          "const": "one",
          "description": "Single row query (404 if not found)"
        },
        "method": { "$ref": "#/$defs/queryMethod" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "handle_not_found": {
          "type": "boolean",
          "description": "Pass null to post-transform instead of returning 404"
        },
        "transform": {
          "$ref": "#/$defs/transformOne"
        }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    },
    "queryMany": {
      "type": "object",
      "properties": {
        "type": {
          "const": "many",
          "description": "Multiple rows query (returns array)"
        },
        "method": { "$ref": "#/$defs/queryMethod" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": {
          "$ref": "#/$defs/transformMany"
        }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    },
    "mutationOne": {
      "type": "object",
      "properties": {
        "type": {
          "const": "one",
          "description": "Mutation returning single row (via RETURNING)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": {
          "$ref": "#/$defs/transformOne"
        }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    },
    "mutationMany": {
      "type": "object",
      "properties": {
        "type": {
          "const": "many",
          "description": "Mutation returning multiple rows (via RETURNING)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": {
          "$ref": "#/$defs/transformMany"
        }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    },
    "mutationNone": {
      "type": "object",
      "properties": {
        "type": {
          "const": "none",
          "description": "Mutation with no return value (204 No Content)"
        },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "sql": { "$ref": "#/$defs/sql" },
        "accepts": { "$ref": "#/$defs/accepts" },
        "transform": {
          "$ref": "#/$defs/transformNone"
        }
      },
      "required": ["type", "path", "sql"],
      "additionalProperties": false
    },
    "transformOne": {
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" },
        "mock": { "$ref": "#/$defs/mockTransform" },
        "post": {
          "type": "string",
          "description": "JavaScript to transform result. Signature: function(ctx, input, output)"
        }
      },
      "additionalProperties": false
    },
    "transformMany": {
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" },
        "mock": { "$ref": "#/$defs/mockTransform" },
        "post": {
          "oneOf": [
            { "$ref": "#/$defs/postTransformAll" },
            {
              "type": "object",
              "properties": {
                "each": {
                  "type": "string",
                  "description": "Transform each row individually. Signature: function(ctx, input, output)"
                },
                "all": { "$ref": "#/$defs/postTransformAll" }
              },
              "additionalProperties": false
            }
          ],
          "description": "JavaScript to transform results"
        }
      },
      "additionalProperties": false
    },
    "transformNone": {
      "type": "object",
      "properties": {
        "pre": { "$ref": "#/$defs/preTransform" },
        "mock": { "$ref": "#/$defs/mockTransform" }
      },
      "additionalProperties": false,
      "description": "Transform for mutations with no return value (pre only, no post)"
    }
  }
}
